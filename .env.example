# Optional overrides for the MCP server and pony-phone CLI.
# Copy to .env and export the values (the processes read the environment;
# they do not load this file automatically).

# Relay HTTP origin. Default: https://relay.pony.karlmagendavid.com
# PONY_RELAY=https://relay.pony.karlmagendavid.com

# Name shown on the phone. Default: Grok Bot
# PONY_CLIENT_NAME=My assistant

# Where the saved pairing (and its private session key) is kept.
# Defaults: ~/.pony/mcp.json for the MCP server, ~/.pony/listen.json for the CLI.
# PONY_STATE=
# PONY_HOME=

# Set to 1 to keep a standing listener after pairing (MCP server).
# PONY_LISTEN=
