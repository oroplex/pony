# Optional overrides for a self-hosted relay.
# Copy to .env and export the values, or pass them through docker compose.

# Listen address. Defaults: 0.0.0.0:8787
# HOST=0.0.0.0
# PORT=8787

# Public wss:// origin the phone should dial when it differs from the Host header.
# PONY_RELAY_URL=wss://relay.pony.karlmagendavid.com

# Abuse limits. Defaults are safe for the 0.6.4 phone and MCP connector.
# PONY_MAX_PAYLOAD_BYTES=16777216
# PONY_MAX_HTTP_BODY_BYTES=65536
# PONY_MAX_ROOMS=10000
# PONY_MAX_ROOMS_PER_IP=50
# PONY_MAX_PAIR_PER_IP=30
# PONY_MAX_WS_PER_IP=40
# PONY_MAX_CONNECT_PER_IP=60
# PONY_MAX_MESSAGES_PER_SEC=60
# PONY_LIMIT_WINDOW_MS=60000
