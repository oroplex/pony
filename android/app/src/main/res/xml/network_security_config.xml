<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext only for private networks. Android cannot list IP ranges here,
        so Tailscale (100.64.0.0/10) and RFC 1918 LAN addresses (10/8, 172.16/12,
        192.168/16) are dialed through the two .invalid aliases below, which only
        CleartextPolicy maps to a real address. Everything else stays https/wss.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="false">pony-tailscale.invalid</domain>
        <domain includeSubdomains="false">pony-lan.invalid</domain>
    </domain-config>
</network-security-config>
