<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_pill"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_mic_circle"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="@string/widget_hint" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_hint"
        android:textColor="@color/pony_ink"
        android:textSize="16sp" />
</LinearLayout>
